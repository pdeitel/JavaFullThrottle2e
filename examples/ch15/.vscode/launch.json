{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Run TipCalculator (JavaFX)",
      "request": "launch",
      "mainClass": "TipCalculator",
      "preLaunchTask": "maven-compile-ch15",
      "vmArgs": "--module-path \"${workspaceFolder}/target/lib\" --add-modules javafx.controls,javafx.fxml --enable-native-access=javafx.graphics",
      "classPaths": [
        "${workspaceFolder}/target/classes"
      ]
    }
  ]
}